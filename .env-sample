# Shared configuration for PHP UI and Python CLI
APP_BASE_URL=http://localhost:8000
UPLOAD_DIR=./uploads
PROMPT_FILE=./prompts/default_prompt.md
PYTHON_BIN=python3

GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SEC=180

# OpenRouter is optional. Leave OPENROUTER_API_KEY blank to disable it entirely
# (its models will not appear in Settings and comparison stays Gemini-only).
# OPENROUTER_MODELS is a curated, comma-separated allow-list of OpenRouter model ids
# (each must be "<vendor>/<name>", OpenRouter's own naming) -- keep this short and
# intentional rather than pulling OpenRouter's full 400+ model catalog live, since
# every model added here is one more paid API call per card during comparison runs.
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_TIMEOUT_SEC=180
# Reasoning-capable models (GPT-5/6, Claude Opus/Fable, Grok 4, Kimi K3...) bill hidden
# thinking tokens at output price. low | medium | high | default (= provider default).
OPENROUTER_REASONING_EFFORT=low
# Transient network failures (DNS, timeouts, HTTP 429/5xx) are retried this many times.
LLM_HTTP_RETRIES=3
OPENROUTER_MODELS=qwen/qwen2.5-vl-72b-instruct,anthropic/claude-sonnet-4.5,openai/gpt-4.1-mini,anthropic/claude-fable-5.1,anthropic/claude-opus-5,openai/gpt-6-astra,openai/gpt-5.6-terra,x-ai/grok-4.6,moonshotai/kimi-k3,mistralai/mistral-medium-3-5,mistralai/mistral-small-2603,deepseek/deepseek-v4.1-flash,meta-llama/llama-4-maverick,qwen/qwen3-vl-235b-a22b-instruct,qwen/qwen3-vl-32b-instruct,z-ai/glm-4.6v

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=kakracards
MYSQL_USER=kakracards
MYSQL_PASSWORD=change_me
